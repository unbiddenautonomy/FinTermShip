{
  "name": "fintermship",
  "compatibility_date": "2026-11-01",
  // The Worker answers /api/ (accounts and sync); everything else is the app's files.
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Pull request builds run `wrangler preview`, which needs this block. Empty means previews use the settings above.
  "previews": {}
}
