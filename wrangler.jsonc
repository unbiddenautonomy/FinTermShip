{
  "name": "fintermship",
  "compatibility_date": "2026-11-01",
  // The Worker answers every request: /api/ is accounts and sync, and the app's files go only to a signed-in session.
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // The admin account: signs up without an invite and makes invites for everyone else.
  // Kept here because the repository is private. A runtime secret named ADMIN_EMAIL, if one is set, takes its place.
  "vars": {
    "OWNER_EMAIL": "workiket@gmail.com"
  },
  // Accounts and progress sync (see the README). Tables are created on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fintermship",
      "database_id": "cbfac63f-79b0-4fcf-83ca-90541458b658"
    }
  ],
  // Pull request builds run `wrangler preview`, which reads only this block: settings above don't carry over.
  // Previews get a database of their own, so testing a pull request never touches learners' accounts.
  "previews": {
    "vars": {
      "OWNER_EMAIL": "workiket@gmail.com"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "fintermship-preview",
        "database_id": "dec99ed8-c1ec-440f-8c14-dd3bd1b5b62a"
      }
    ]
  }
}
