{
  "name": "fintermship",
  "compatibility_date": "2026-11-01",
  // The Worker answers /api/ (accounts and sync); everything else is the app's files.
  "main": "worker/index.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The admin account: signs up without an invite and makes invites for everyone else.
  // Kept here because the repository is private. A runtime secret named ADMIN_EMAIL, if one is set, takes its place.
  "vars": {
    "OWNER_EMAIL": "workiket@gmail.com"
  },
  // Accounts and progress sync (see the README). Tables are created on first use.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fintermship",
      "database_id": "cbfac63f-79b0-4fcf-83ca-90541458b658"
    }
  ],
  // Pull request builds run `wrangler preview`, which needs this block. Empty means previews use the settings above.
  "previews": {}
}
