{
  "name": "fintermship",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Pull request builds run `wrangler preview`, which needs this block. Empty means previews use the settings above.
  "previews": {}
}
